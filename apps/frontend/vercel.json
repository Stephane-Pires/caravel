{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter backend db:deploy && pnpm build",
  "git": {
    "deploymentEnabled": {
      "dev-*": false,
      "renovate/**": false,
      "changeset-release/**": false
    }
  }
}
