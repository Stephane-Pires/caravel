{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx -y pnpm@10.28.2 install --frozen-lockfile",
  "buildCommand": "npx -y pnpm@10.28.2 --filter backend db:deploy && npx -y pnpm@10.28.2 build",
  "git": {
    "deploymentEnabled": {
      "dev-*": false,
      "renovate/**": false,
      "changeset-release/**": false
    }
  }
}
